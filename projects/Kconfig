mainmenu "ARBATOS Zephyr firmware"

source "Kconfig.zephyr"

menu "ARBATOS robot application"

config ARBATOS_ROBOT_NAME
    string "Robotconfig target name"
    default "HERO-M"
    help
      This value is generated from Robotconfig/<target>/RobotConfig.toml.
      Do not select a target here: board, sources and target settings all
      come from that same declaration before Zephyr configuration starts.

# 兼容尚未迁移的板级功能；新车型不需要在这里加枚举项。
config ARBATOS_TARGET_HERO_M
    bool
    default y if ARBATOS_ROBOT_NAME = "HERO-M"

config ARBATOS_TARGET_SENTINEL_M
    bool
    default y if ARBATOS_ROBOT_NAME = "SENTINEL-M"

config ARBATOS_TARGET_MINIWHEELEG_M
    bool
    default y if ARBATOS_ROBOT_NAME = "MINIWHEELEG-M"

config ARBATOS_LEGACY_SOURCES
    bool "Compile selected robot's shared ARBATOS sources"
    default n
    help
      Adds the selected Robotconfig, shared application, algorithm and support
      source manifest through the Zephyr compatibility and board-driver layers.
      The symbol keeps its historical name so existing configurations still work.

config ARBATOS_BOOT_BANNER
    bool "Print target name at startup"
    default y

config ARBATOS_M_BOARD_IO
    bool
    default y if BOARD_DM_MC02_H7 && ARBATOS_LEGACY_SOURCES
    select ADC
    select CRC
    select FLASH
    select FLASH_MAP

config ARBATOS_LOG_RAM
    bool "Keep Zephyr messages in debugger-readable RAM"
    depends on LOG && !LOG_MODE_MINIMAL
    select LOG_OUTPUT
    default y
    help
      Supplies a log backend when no UART console is available. Old messages
      are overwritten without waiting for a connected debugger.

config ARBATOS_SUBBOARD_MUSIC
    bool "M subboard SD music and track buttons"
    depends on BOARD_DM_MC02_H7 && ARBATOS_LEGACY_SOURCES
    default y if ARBATOS_ROBOT_NAME = "HERO-M"
    help
      Play SD PCM music using the V2 subboard buttons PD14 and PD15.

config ARBATOS_MUSIC_ONLY
    bool "Start only the SD music service"
    depends on ARBATOS_SUBBOARD_MUSIC
    default n
    help
      Bench startup for validating the formal Zephyr storage and audio ports.
      Does not initialize CAN or start robot control, heater or servo tasks.

config ARBATOS_PREFLIGHT_ONLY
    bool "Run stationary M board checks without motor tasks"
    depends on BOARD_DM_MC02_H7 && ARBATOS_LEGACY_SOURCES
    depends on !ARBATOS_MUSIC_ONLY
    default n
    help
      Starts only IMU acquisition, its bounded heater and SD logging checks.
      CAN transmit, robot control and external servo tasks remain inactive.

config ARBATOS_RECEIVE_ONLY
    bool "HERO-M receive checks with command transmission blocked"
    depends on ARBATOS_PREFLIGHT_ONLY && ARBATOS_ROBOT_NAME = "HERO-M"
    default n
    help
      Receive CAN feedback and remote input alongside preflight IMU checks.
      CAN hardware acknowledges frames, but application CAN and UART sends
      are rejected. No motion task is started; diagnostics use debug RAM.

config ARBATOS_FREERTOS_MAX_TASKS
    int "Maximum legacy task count"
    default 32
    range 16 64
    help
      Fixed-capacity task and notification registry used while the existing
      application tasks move from FreeRTOS/CMSIS-RTOS to native Zephyr APIs.

config ARBATOS_THREAD_STACK_POOL_SIZE
    int "Static legacy thread stack pool size in bytes"
    default 8192
    range 4096 16384
    help
      Fallback pool used only when osThreadNew is called without a caller
      supplied stack.  ARBATOS runtime tasks keep their explicit static
      stacks in CPU-local CCM/DTCM memory.  This pool is boot-only monotonic:
      memory is never freed or allocated from the Zephyr heap.

config ARBATOS_CMSIS_MUTEX_COUNT
    int "Maximum legacy CMSIS mutex count"
    default 16
    range 4 32

config ARBATOS_LEGACY_HEAP_SIZE
    int "Bounded legacy application heap size in bytes"
    default 32768 if ARBATOS_LEGACY_SOURCES
    default 8192
    range 4096 65536
    help
      Dedicated Zephyr heap used only by the existing heap_malloc and
      pvPortMalloc compatibility calls.  Control threads and driver rings use
      static storage and do not consume this heap.

config APP_LINK_WITH_ARBATOS_PORT
    bool
    default y
    help
      Lets applications using this directory as ZEPHYR_EXTRA_MODULES inherit
      the public ARBATOS migration headers from the arbatos_port interface.

endmenu
