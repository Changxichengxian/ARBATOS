 #endif /* CONFIG_CAN_MANUAL_RECOVERY_MODE */
 
+static uint32_t can_stm32_get_tx_mailboxes(const struct device *dev)
+{
+	const struct can_stm32_config *cfg = dev->config;
+	struct can_stm32_data *data = dev->data;
+	uint32_t status = cfg->can->TSR;
+
+	/* 硬件已空闲但旧完成回调尚未交付时，邮箱仍属于旧请求。 */
+	if (data->mb0.tx_callback != NULL) {
+		status &= ~CAN_TSR_TME0;
+	}
+	if (data->mb1.tx_callback != NULL) {
+		status &= ~CAN_TSR_TME1;
+	}
+	if (data->mb2.tx_callback != NULL) {
+		status &= ~CAN_TSR_TME2;
+	}
+	return status;
+}
+
 static int can_stm32_send(const struct device *dev, const struct can_frame *frame,
 			  k_timeout_t timeout, can_tx_callback_t callback,
 			  void *user_data)
@@ -768,6 +791,7 @@ static int can_stm32_send(const struct device *dev, const struct can_frame *fram
 	uint32_t transmit_status_register = 0;
