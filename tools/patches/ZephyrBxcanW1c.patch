+	key = irq_lock();
+	transmit_status_register = can_stm32_get_tx_mailboxes(dev);
 	while (!(transmit_status_register & CAN_TSR_TME)) {
+		irq_unlock(key);
 		k_mutex_unlock(&data->inst_mutex);
 		LOG_DBG("Transmit buffer full");
 		if (k_sem_take(&data->tx_int_sem, timeout)) {
@@ -806,7 +832,8 @@ static int can_stm32_send(const struct device *dev, const struct can_frame *fram
 		}
 
 		k_mutex_lock(&data->inst_mutex, K_FOREVER);
-		transmit_status_register = can->TSR;
+		key = irq_lock();
+		transmit_status_register = can_stm32_get_tx_mailboxes(dev);
 	}
 
 	if (transmit_status_register & CAN_TSR_TME0) {
@@ -823,8 +850,8 @@ static int can_stm32_send(const struct device *dev, const struct can_frame *fram
 		mb = &data->mb2;
 	}
 
-	mb->tx_callback = callback;
 	mb->callback_arg = user_data;
+	mb->tx_callback = callback;
 
 	/* mailbox identifier register setup */
 	mailbox->TIR &= CAN_TI0R_TXRQ;
@@ -846,6 +873,7 @@ static int can_stm32_send(const struct device *dev, const struct can_frame *fram
 	mailbox->TDTR = ((frame->dlc & 0xF) << CAN_TDT1R_DLC_Pos);
 
 	mailbox->TIR |= CAN_TI0R_TXRQ;
+	irq_unlock(key);
 	k_mutex_unlock(&data->inst_mutex);
 
 	return 0;
